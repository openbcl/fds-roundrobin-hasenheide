! ============================================================================
! VIB Hasenheide FDS Round-Robin Study - Stage 1: Semi-Blind Prediction
! Scenario: hep_160_150
!
! This input file provides the reference geometry and measurement locations
! for the semi-blind prediction exercise.
!
! The following elements are intentionally NOT prescribed and shall be defined
! by the participants:
!   - Computational mesh (MESH)
!   - Reaction / fuel model (REAC)
!   - Fire source implementation based on the provided fuel mass history
!   - Soot yield, CO yield and radiative fraction
!   - Wall and material properties
!   - Leakage assumptions
!   - Smoke detector model or activation criterion
!
! The quantities and locations defined via DEVC entries form the common basis
! for intercomparison. Additional quantities and sensors may be used, provided
! they are documented in the questionnaire.
!
! IMPORTANT: Do NOT rename or remove the DEVC entries defined in this template.
! Consistent IDs across all submissions are required for automated
! post-processing and intercomparison. Additional DEVC entries may be added.
!
! Do NOT modify the &MISC and &DUMP settings. These define the common ambient
! conditions and output intervals for all submissions.
!
! Windows remain closed during the pre-ventilation phase.
! Air leakage is present but not explicitly defined.
!
! FDS version: 6.11.0
! Simulation end time corresponds to the pre-ventilation period.
!
! This template is not intended to be run without participant-defined MESH,
! REAC and fire source entries.
! ============================================================================

! Replace <ParticipantID> with the assigned anonymous participant ID.
! Replace <RunID> with best_estimate, sensitivity_01, sensitivity_02, ...
&HEAD CHID='hep_160_150_<ParticipantID>_<RunID>',
      TITLE='VIB Hasenheide Stage 1 | hep_160_150 | <ParticipantID> | <RunID>'/

&TIME T_END=1200.0/ ! Pre-ventilation period
&DUMP DT_CPU=1.0, DT_CTRL=1.0, DT_DEVC=1.0, DT_HRR=1.0, DT_MASS=1.0, MASS_FILE=.TRUE./
&MISC TMPA=12.1, HUMIDITY=73.2, P_INF=99300.0/

! ---------------------------------------------------------------------------
! Computational mesh
!
! Participants shall define the computational mesh. The outline below indicates
! the approximate compartment-wise mesh extents only. Mesh resolution, mesh
! decomposition and any local mesh refinement remain participant choices and
! shall be documented in the questionnaire.
!
! Example structure only – replace IJK=... before running.
! ---------------------------------------------------------------------------

&MESH ID='F1', IJK=..., XB=0.0,4.25,0.00,4.40,0.0,2.55/
&MESH ID='F2', IJK=..., XB=0.0,4.60,4.40,7.70,0.0,2.55/
&MESH ID='FC', IJK=..., XB=0.0,1.05,7.70,11.2,0.0,2.55/
&MESH ID='F3', IJK=..., XB=0.0,4.60,11.2,14.5,0.0,2.55/

! Participants shall define REAC, fire source implementation,
! soot yield, CO yield and radiative fraction.

! Default wall/material properties are intentionally not prescribed.
! Participants shall document inert or thermally active wall assumptions.

&OBST ID='Wall_01', XB=0.00,0.45, 4.40, 4.8,0.0,2.55/ 
&OBST ID='Wall_02', XB=0.00,0.45, 14.1,14.5,0.0,2.55/ 
&OBST ID='Wall_03', XB=0.00,1.05, 7.70,7.85,0.0,2.55/ 
&OBST ID='Wall_04', XB=0.00,1.05,11.05,11.2,0.0,2.55/ 
&OBST ID='Wall_05', XB=0.00,4.60, 4.20, 4.4,0.0,2.55/ 
&OBST ID='Wall_06', XB=4.15,4.25, 0.00, 4.2,0.0,2.55/ 
&OBST ID='Wall_07', XB=4.50,4.60, 4.40, 7.7,0.0,2.55/ 
&OBST ID='Wall_08', XB=4.50,4.60, 11.2,14.5,0.0,2.55/ 

&HOLE ID='Door_F1-F2', XB=0.82,1.65,4.15, 4.45,-0.05,1.97/ 
&HOLE ID='Door_F2-FC', XB=0.13,0.95,7.65, 7.90,-0.05,1.97/ 
&HOLE ID='Door_FC-F3', XB=0.11,0.95,11.0,11.25,-0.05,1.97/ 

! Window openings are cut into the wall and then closed by OBST Window_*.
! Windows remain closed during the pre-ventilation phase.
&OBST ID='Window_F1', XB=4.24,4.25, 1.36, 2.65,0.92,2.14, PERMIT_HOLE=.FALSE./ 
&OBST ID='Window_F2', XB=4.59,4.60, 5.40, 6.69,0.92,2.14, PERMIT_HOLE=.FALSE./ 
&OBST ID='Window_F3', XB=4.59,4.60,12.22,13.55,0.92,2.23, PERMIT_HOLE=.FALSE./ 
&HOLE ID='Window_F1', XB=4.10,4.25, 1.36, 2.65,0.92,2.14/ 
&HOLE ID='Window_F2', XB=4.45,4.60, 5.40, 6.69,0.92,2.14/ 
&HOLE ID='Window_F3', XB=4.45,4.60,12.22,13.55,0.92,2.23/ 

! The pan geometry below approximates the 160 mm x 160 mm steel pan with coordinates
! snapped to multiples of 0.05 m, compatible with mesh cell sizes that are multiples
! or fractions of 5 cm. The resulting fuel surface (Fire_pan) is 150 mm x 150 mm = 0.0225 m².
! When prescribing MLRPUA or HRRPUA from the fuel mass history, use the actual
! fuel area of 0.0256 m² (= 160 mm x 160 mm), not the model geometry.
&OBST ID='Load_cell',  XB=1.800,2.350,1.900,2.350,0.00,0.15/
&OBST ID='Fire_pan',   XB=2.000,2.150,2.050,2.200,0.20,0.20/ ! fuel surface, 150 mm x 150 mm
&OBST ID='Pan_wall_W', XB=2.000,2.000,2.050,2.200,0.20,0.30/
&OBST ID='Pan_wall_E', XB=2.150,2.150,2.050,2.200,0.20,0.30/
&OBST ID='Pan_wall_S', XB=2.000,2.150,2.050,2.050,0.20,0.30/
&OBST ID='Pan_wall_N', XB=2.000,2.150,2.200,2.200,0.20,0.30/

! Thermocouples: bead diameter 1 mm (= FDS default). QUANTITY='THERMOCOUPLE' models the
! radiation-affected bead response (not the gas temperature) to match the measured TCs.
&DEVC ID='TC_Ceiling_F1', QUANTITY='THERMOCOUPLE', XYZ=2.0625,2.1375,2.54/

&DEVC ID='TC_F1_0_6', QUANTITY='THERMOCOUPLE', XYZ=3.650,0.5,0.6/
&DEVC ID='TC_F1_1_2', QUANTITY='THERMOCOUPLE', XYZ=3.650,0.5,1.2/
&DEVC ID='TC_F1_1_6', QUANTITY='THERMOCOUPLE', XYZ=3.650,0.5,1.6/
&DEVC ID='TC_F1_1_8', QUANTITY='THERMOCOUPLE', XYZ=3.650,0.5,1.8/
&DEVC ID='TC_F1_2_0', QUANTITY='THERMOCOUPLE', XYZ=3.650,0.5,2.0/
&DEVC ID='TC_F1_2_2', QUANTITY='THERMOCOUPLE', XYZ=3.650,0.5,2.2/
&DEVC ID='TC_F1_2_4', QUANTITY='THERMOCOUPLE', XYZ=3.650,0.5,2.4/
&DEVC ID='TC_F1_2_5', QUANTITY='THERMOCOUPLE', XYZ=3.650,0.5,2.5/

&DEVC ID='EXT_F1_0_6', QUANTITY='EXTINCTION COEFFICIENT', XYZ=3.650,0.5,0.6/
&DEVC ID='EXT_F1_1_2', QUANTITY='EXTINCTION COEFFICIENT', XYZ=3.650,0.5,1.2/
&DEVC ID='EXT_F1_1_6', QUANTITY='EXTINCTION COEFFICIENT', XYZ=3.650,0.5,1.6/
&DEVC ID='EXT_F1_1_8', QUANTITY='EXTINCTION COEFFICIENT', XYZ=3.650,0.5,1.8/
&DEVC ID='EXT_F1_2_0', QUANTITY='EXTINCTION COEFFICIENT', XYZ=3.650,0.5,2.0/
&DEVC ID='EXT_F1_2_2', QUANTITY='EXTINCTION COEFFICIENT', XYZ=3.650,0.5,2.2/
&DEVC ID='EXT_F1_2_4', QUANTITY='EXTINCTION COEFFICIENT', XYZ=3.650,0.5,2.4/
&DEVC ID='EXT_F1_2_5', QUANTITY='EXTINCTION COEFFICIENT', XYZ=3.650,0.5,2.5/

&DEVC ID='TC_F2_0_6', QUANTITY='THERMOCOUPLE', XYZ=2.225,5.9,0.6/
&DEVC ID='TC_F2_1_2', QUANTITY='THERMOCOUPLE', XYZ=2.225,5.9,1.2/
&DEVC ID='TC_F2_1_6', QUANTITY='THERMOCOUPLE', XYZ=2.225,5.9,1.6/
&DEVC ID='TC_F2_1_8', QUANTITY='THERMOCOUPLE', XYZ=2.225,5.9,1.8/
&DEVC ID='TC_F2_2_0', QUANTITY='THERMOCOUPLE', XYZ=2.225,5.9,2.0/
&DEVC ID='TC_F2_2_2', QUANTITY='THERMOCOUPLE', XYZ=2.225,5.9,2.2/
&DEVC ID='TC_F2_2_4', QUANTITY='THERMOCOUPLE', XYZ=2.225,5.9,2.4/
&DEVC ID='TC_F2_2_5', QUANTITY='THERMOCOUPLE', XYZ=2.225,5.9,2.5/

&DEVC ID='EXT_F2_0_6', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.225,5.9,0.6/
&DEVC ID='EXT_F2_1_2', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.225,5.9,1.2/
&DEVC ID='EXT_F2_1_6', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.225,5.9,1.6/
&DEVC ID='EXT_F2_1_8', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.225,5.9,1.8/
&DEVC ID='EXT_F2_2_0', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.225,5.9,2.0/
&DEVC ID='EXT_F2_2_2', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.225,5.9,2.2/
&DEVC ID='EXT_F2_2_4', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.225,5.9,2.4/
&DEVC ID='EXT_F2_2_5', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.225,5.9,2.5/

&DEVC ID='TC_F3_0_6', QUANTITY='THERMOCOUPLE', XYZ=2.275,12.925,0.6/
&DEVC ID='TC_F3_1_2', QUANTITY='THERMOCOUPLE', XYZ=2.275,12.925,1.2/
&DEVC ID='TC_F3_1_6', QUANTITY='THERMOCOUPLE', XYZ=2.275,12.925,1.6/
&DEVC ID='TC_F3_1_8', QUANTITY='THERMOCOUPLE', XYZ=2.275,12.925,1.8/
&DEVC ID='TC_F3_2_0', QUANTITY='THERMOCOUPLE', XYZ=2.275,12.925,2.0/
&DEVC ID='TC_F3_2_2', QUANTITY='THERMOCOUPLE', XYZ=2.275,12.925,2.2/
&DEVC ID='TC_F3_2_4', QUANTITY='THERMOCOUPLE', XYZ=2.275,12.925,2.4/
&DEVC ID='TC_F3_2_5', QUANTITY='THERMOCOUPLE', XYZ=2.275,12.925,2.5/

&DEVC ID='EXT_F3_0_6', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275,12.925,0.6/
&DEVC ID='EXT_F3_1_2', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275,12.925,1.2/
&DEVC ID='EXT_F3_1_6', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275,12.925,1.6/
&DEVC ID='EXT_F3_1_8', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275,12.925,1.8/
&DEVC ID='EXT_F3_2_0', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275,12.925,2.0/
&DEVC ID='EXT_F3_2_2', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275,12.925,2.2/
&DEVC ID='EXT_F3_2_4', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275,12.925,2.4/
&DEVC ID='EXT_F3_2_5', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275,12.925,2.5/

&DEVC ID='EXT_DEVC_F1_2_3', QUANTITY='EXTINCTION COEFFICIENT', XYZ=3.150, 3.725,2.3/
&DEVC ID='EXT_DEVC_F2_1_5', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275, 6.275,1.5/
&DEVC ID='EXT_DEVC_F2_1_9', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275, 6.275,1.9/
&DEVC ID='EXT_DEVC_F2_2_1', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275, 6.275,2.1/
&DEVC ID='EXT_DEVC_F2_2_3', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275, 6.325,2.3/
&DEVC ID='EXT_DEVC_F3_2_3', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275,12.775,2.3/

! ---------------------------------------------------------------------------
! Smoke alarm locations
!
! The experimental smoke alarms were optical smoke alarms according to
! DIN EN 14604. The activation threshold is not prescribed; participants
! shall define, justify and document their own value.
!
! Replace SETPOINT=... with the participant-defined activation threshold
! [1/m]. FDS then records the activation time in the .out file under
! "DEVICE Activation Times"; the continuous extinction coefficient is
! still written to the _devc.csv.
! Alternatively, participants may define an FDS detector model or apply
! a documented post-processing criterion instead of using SETPOINT.
! ---------------------------------------------------------------------------

&DEVC ID='SD_F2_EXT', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.125, 6.000,2.49, SETPOINT=.../ ! Participant-defined activation threshold [1/m]; activation time reported in .out
&DEVC ID='SD_FC_EXT', QUANTITY='EXTINCTION COEFFICIENT', XYZ=0.550, 9.450,2.49, SETPOINT=.../ ! Participant-defined activation threshold [1/m]; activation time reported in .out
&DEVC ID='SD_F3_EXT', QUANTITY='EXTINCTION COEFFICIENT', XYZ=2.275,12.925,2.49, SETPOINT=.../ ! Participant-defined activation threshold [1/m]; activation time reported in .out

! Example only – not prescribed:
! &PROP ID='Smoke Detector', ... /
! &DEVC ID='SD_F2_DET', PROP_ID='Smoke Detector', XYZ=2.125, 6.000,2.49/
! &DEVC ID='SD_FC_DET', PROP_ID='Smoke Detector', XYZ=0.550, 9.450,2.49/
! &DEVC ID='SD_F3_DET', PROP_ID='Smoke Detector', XYZ=2.275,12.925,2.49/

&TAIL /
